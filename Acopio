    <!-- JAVASCRIPT LOGIC -->
    <script>
        // --- GLOBAL STATE ---
        let batches = [];
        let qrCodeObj = null;
        let chartRoutes = null;
        let chartHumidity = null;

        // --- DEMO INITIAL DATA ---
        const initialDemoBatches = [
            {
                id: 'LOT-EAN-1042',
                supplier: 'Central Corabastos (Bogotá)',
                type: 'Frutas y Verduras (Alta Humedad)',
                weight: 240,
                humidity: 'Muy Alta (>85%)',
                route: 'Deshidratación Térmica / Secado',
                status: 'En Procesamiento',
                retentionHours: 2,
                timestamp: '08:30 AM'
            },
            {
                id: 'LOT-EAN-1043',
                supplier: 'Plaza de Mercado Paloquemao',
                type: 'Tubérculos y Cáscaras Duras',
                weight: 180,
                humidity: 'Moderada (60-85%)',
                route: 'Compostaje Automatizado In-Vessel',
                status: 'En Procesamiento',
                retentionHours: 4,
                timestamp: '09:15 AM'
            },
            {
                id: 'LOT-EAN-1044',
                supplier: 'Restaurante Institucional EAN',
                type: 'Residuos Mixtos de Cocina / Restos',
                weight: 65,
                humidity: 'Muy Alta (>85%)',
                route: 'Biológica - Estabilización Bokashi In-Situ',
                status: 'Alerta Pudrición',
                retentionHours: 11,
                timestamp: '06:00 AM'
            },
            {
                id: 'LOT-EAN-1045',
                supplier: 'Plaza 7 de Agosto',
                type: 'Excedentes de Panadería y Cereales',
                weight: 110,
                humidity: 'Baja (<60%)',
                route: 'Alimentación Animal (Norma ICA)',
                status: 'Adecuado',
                retentionHours: 1,
                timestamp: '10:00 AM'
            }
        ];

        // --- SOUND EFFECTS (Web Audio API) ---
        function playScanBeep() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(1800, ctx.currentTime);
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + 0.12);
            } catch (e) {
                console.log("Audio not supported or blocked");
            }
        }

        // --- INITIALIZATION ---
        window.onload = function () {
            // Live clock
            setInterval(updateClock, 1000);
            updateClock();

            // Load Demo Data
            loadDemoData();

            // Init Charts
            initCharts();
        };

        function updateClock() {
            const now = new Date();
            document.getElementById('live-timer').innerText = now.toLocaleTimeString('es-CO');
        }

        function loadDemoData() {
            batches = JSON.parse(JSON.stringify(initialDemoBatches));
            renderAll();
            generateTagForBatch(batches[0]);
        }

        // --- RENDER ALL COMPONENTS ---
        function renderAll() {
            renderTable();
            renderMetrics();
            updateScannerSelectOptions();
            updateCharts();
        }

        // --- FORM SUBMIT HANDLER ---
        function handleFormSubmit(e) {
            e.preventDefault();

            const supplier = document.getElementById('input-supplier').value;
            const type = document.getElementById('input-type').value;
            const weight = parseFloat(document.getElementById('input-weight').value);
            const humidity = document.getElementById('input-humidity').value;
            const route = document.getElementById('input-route').value;

            const newId = 'LOT-EAN-' + Math.floor(1000 + Math.random() * 9000);

            const newBatch = {
                id: newId,
                supplier: supplier,
                type: type,
                weight: weight,
                humidity: humidity,
                route: route,
                status: 'En Recepción',
                retentionHours: 0,
                timestamp: new Date().toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' })
            };

            batches.unshift(newBatch);
            renderAll();
            generateTagForBatch(newBatch);
            playScanBeep();

            // Notification
            showToast(`Lote ${newId} registrado con código QR.`);
        }

        // --- AUTO SUGGEST ROUTE BASED ON TYPE ---
        function autoSuggestRoute() {
            const type = document.getElementById('input-type').value;
            const routeSelect = document.getElementById('input-route');

            if (type.includes('Frutas')) {
                routeSelect.value = 'Deshidratación Térmica / Secado';
            } else if (type.includes('Tubérculos')) {
                routeSelect.value = 'Compostaje Automatizado In-Vessel';
            } else if (type.includes('Panadería')) {
                routeSelect.value = 'Alimentación Animal (Norma ICA)';
            } else if (type.includes('Cárnicos')) {
                routeSelect.value = 'Biodigestión Anaerobia (Biogás)';
            } else {
                routeSelect.value = 'Biológica - Estabilización Bokashi In-Situ';
            }
        }

        // --- QR GENERATION ---
        function generateTagForBatch(batch) {
            document.getElementById('tag-id').innerText = batch.id;
            document.getElementById('tag-type-display').innerText = batch.type;
            document.getElementById('tag-supplier-display').innerText = 'Origen: ' + batch.supplier;
            document.getElementById('tag-weight-display').innerText = batch.weight + ' kg';
            document.getElementById('tag-humidity-display').innerText = batch.humidity;
            document.getElementById('tag-route-display').innerText = batch.route;
            document.getElementById('tag-status-badge').innerText = batch.status;
            document.getElementById('tag-hash').innerText = 'HASH: ' + btoa(batch.id + batch.supplier).substring(0, 16);

            // Render QR Code using QRCode.js
            const qrContainer = document.getElementById("qrcode");
            qrContainer.innerHTML = "";
            
            const qrPayload = JSON.stringify({
                id: batch.id,
                origen: batch.supplier,
                peso: batch.weight,
                ruta: batch.route
            });

            new QRCode(qrContainer, {
                text: qrPayload,
                width: 120,
                height: 120,
                colorDark: "#064e3b",
                colorLight: "#ffffff",
                correctLevel: QRCode.CorrectLevel.H
            });
        }

        // --- RENDER TABLE ---
        function renderTable() {
            const tbody = document.getElementById('batch-table-body');
            const query = document.getElementById('search-batch').value.toLowerCase();
            tbody.innerHTML = '';

            const filtered = batches.filter(b => 
                b.id.toLowerCase().includes(query) || 
                b.supplier.toLowerCase().includes(query) ||
                b.type.toLowerCase().includes(query)
            );

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-400 italic">No hay lotes registrados con ese criterio.</td></tr>`;
                return;
            }

            filtered.forEach(batch => {
                let statusBadge = '';
                if (batch.status === 'En Recepción') {
                    statusBadge = `<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded text-[10px] font-bold">En Recepción</span>`;
                } else if (batch.status === 'Alerta Pudrición') {
                    statusBadge = `<span class="bg-red-100 text-red-800 px-2 py-0.5 rounded text-[10px] font-bold pulse-badge"><i class="fa-solid fa-triangle-exclamation"></i> Riesgo >8h</span>`;
                } else if (batch.status === 'En Procesamiento') {
                    statusBadge = `<span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded text-[10px] font-bold">En Adecuación</span>`;
                } else {
                    statusBadge = `<span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded text-[10px] font-bold"><i class="fa-solid fa-check"></i> Estabilizado</span>`;
                }

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition border-b border-slate-100";
                tr.innerHTML = `
                    <td class="p-3 font-mono font-bold text-emerald-900">${batch.id}</td>
                    <td class="p-3">
                        <div class="font-semibold text-slate-800">${batch.supplier}</div>
                        <div class="text-[10px] text-slate-400">${batch.timestamp}</div>
                    </td>
                    <td class="p-3">
                        <div class="text-slate-800">${batch.type}</div>
                        <div class="font-bold text-slate-900">${batch.weight} kg</div>
                    </td>
                    <td class="p-3 text-emerald-800 font-medium">${batch.route}</td>
                    <td class="p-3">${statusBadge}</td>
                    <td class="p-3 text-right">
                        <button onclick="selectAndScanBatch('${batch.id}')" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 px-2 py-1 rounded text-xs font-bold transition">
                            <i class="fa-solid fa-qrcode mr-1"></i> Escanear
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // --- RENDER DASHBOARD METRICS ---
        function renderMetrics() {
            const totalWeight = batches.reduce((acc, b) => acc + b.weight, 0);
            // Leachates avoided calculation: approx 0.45L per kg of wet organic waste treated in-situ
            const leachatesAvoided = Math.round(totalWeight * 0.45);
            const alertCount = batches.filter(b => b.status === 'Alerta Pudrición' || b.retentionHours >= 8).length;
            const processedCount = batches.filter(b => b.status === 'Adecuado' || b.status === 'En Procesamiento').length;
            const successRate = batches.length ? Math.round((processedCount / batches.length) * 100) : 100;

            document.getElementById('stat-total-weight').innerText = totalWeight.toLocaleString() + ' kg';
            document.getElementById('stat-leachate-avoided').innerText = leachatesAvoided.toLocaleString() + ' L';
            document.getElementById('stat-alert-count').innerText = alertCount;
            document.getElementById('stat-alert-status').innerText = `${alertCount} lotes con retención crítica`;
            document.getElementById('stat-success-rate').innerText = successRate + '%';
        }

        // --- TAB SWITCHER ---
        function switchTab(tabId) {
            ['tab-table', 'tab-scanner', 'tab-analytics'].forEach(id => {
                document.getElementById(id).classList.add('hidden');
            });
            document.getElementById(tabId).classList.remove('hidden');

            // Style active button
            const btns = {
                'tab-table': 'btn-tab-table',
                'tab-scanner': 'btn-tab-scanner',
                'tab-analytics': 'btn-tab-analytics'
            };

            Object.keys(btns).forEach(key => {
                const btn = document.getElementById(btns[key]);
                if (key === tabId) {
                    btn.className = "flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition flex items-center justify-center space-x-2 bg-emerald-700 text-white shadow";
                } else {
                    btn.className = "flex-1 py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold transition flex items-center justify-center space-x-2 text-slate-600 hover:bg-slate-100";
                }
            });

            if (tabId === 'tab-analytics') {
                updateCharts();
            }
        }

        // --- SCANNER SIMULATION LOGIC ---
        function updateScannerSelectOptions() {
            const select = document.getElementById('scanner-batch-select');
            select.innerHTML = '';
            batches.forEach(b => {
                const opt = document.createElement('option');
                opt.value = b.id;
                opt.innerText = `${b.id} - ${b.supplier} (${b.weight} kg)`;
                select.appendChild(opt);
            });
        }

        function selectAndScanBatch(batchId) {
            switchTab('tab-scanner');
            document.getElementById('scanner-batch-select').value = batchId;
            executeScanFromSelect();
        }

        function simulateScannerWithCurrentTag() {
            const currentId = document.getElementById('tag-id').innerText;
            if (currentId && currentId !== 'LOT-EAN-0000') {
                selectAndScanBatch(currentId);
            } else {
                showToast("Primero registre un lote para generar la etiqueta QR.");
            }
        }

        function executeScanFromSelect() {
            const selectedId = document.getElementById('scanner-batch-select').value;
            const batch = batches.find(b => b.id === selectedId);

            if (!batch) return;

            // Audio & visual feedback
            playScanBeep();
            const feedback = document.getElementById('scanner-feedback');
            feedback.innerText = `¡CÓDIGO LIDO: ${batch.id}!`;
            feedback.className = "inline-block bg-emerald-500 text-emerald-950 font-black text-xs px-4 py-1 rounded-full border border-white animate-bounce";

            // Update status
            batch.status = 'Adecuado';

            setTimeout(() => {
                feedback.innerText = "Escáner Industrial Óptico Listo";
                feedback.className = "inline-block bg-emerald-900/80 text-emerald-300 text-xs px-3 py-1 rounded-full border border-emerald-700 font-mono";
            }, 3000);

            // Display scanned card
            const resultCard = document.getElementById('scan-result-card');
            resultCard.classList.remove('hidden');
            document.getElementById('scan-res-id').innerText = batch.id;
            document.getElementById('scan-res-detail').innerHTML = `
                <strong>Origen:</strong> ${batch.supplier} | 
                <strong>Peso:</strong> ${batch.weight} kg | 
                <strong>Ruta Ejecutada:</strong> <span class="text-emerald-800 font-bold">${batch.route}</span>
            `;

            renderAll();
        }

        // --- PRINTING TAG ---
        function printTag() {
            window.print();
        }

        // --- MODAL TOGGLE ---
        function toggleGuideModal() {
            const modal = document.getElementById('modal-guide');
            modal.classList.toggle('hidden');
        }

        // --- SIMPLE TOAST NOTIFICATION ---
        function showToast(msg) {
            const toast = document.createElement('div');
            toast.className = "fixed bottom-4 right-4 bg-emerald-900 text-white text-xs font-bold px-4 py-3 rounded-xl shadow-2xl z-50 flex items-center space-x-2 border border-emerald-700 transition transform translate-y-0";
            toast.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-400 text-base"></i> <span>${msg}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.remove();
            }, 3500);
        }

        // --- CHART.JS IMPLEMENTATION ---
        function initCharts() {
            const ctxRoutes = document.getElementById('chart-routes').getContext('2d');
            chartRoutes = new Chart(ctxRoutes, {
                type: 'doughnut',
                data: {
                    labels: ['Deshidratación', 'Bokashi In-Situ', 'Compostaje In-Vessel', 'Alimentación Animal'],
                    datasets: [{
                        data: [40, 25, 20, 15],
                        backgroundColor: ['#059669', '#10b981', '#34d399', '#f59e0b']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, font: { size: 10 } } } }
                }
            });

            const ctxHumidity = document.getElementById('chart-humidity').getContext('2d');
            chartHumidity = new Chart(ctxHumidity, {
                type: 'bar',
                data: {
                    labels: ['Corabastos', 'Paloquemao', '7 de Agosto', 'EAN Casino'],
                    datasets: [{
                        label: 'Humedad Promedio %',
                        data: [88, 82, 75, 90],
                        backgroundColor: '#047857'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { min: 50, max: 100 } }
                }
            });
        }

        function updateCharts() {
            if (!chartRoutes) return;
            
            // Calculate dynamic counts
            const routeCounts = {};
            batches.forEach(b => {
                const shortRoute = b.route.split(' ')[0];
                routeCounts[shortRoute] = (routeCounts[shortRoute] || 0) + b.weight;
            });

            const labels = Object.keys(routeCounts);
            const data = Object.values(routeCounts);

            if (labels.length > 0) {
                chartRoutes.data.labels = labels;
                chartRoutes.data.datasets[0].data = data;
                chartRoutes.update();
            }
        }
    </script>
